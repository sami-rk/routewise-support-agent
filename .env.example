# --- LLM layer: OpenRouter, free-tier models only -----------------------------
# A key is needed for live LLM calls. The test suite runs without one.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated, tried in order. Only ":free" ids and "openrouter/free" are allowed.
LLM_MODELS=openrouter/free
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2

# --- Router (Laya, local) -----------------------------------------------------
# laya | fake   ("fake" needs no model download and is used by the tests)
ROUTER_BACKEND=laya
ROUTER_CHECKPOINT=convaiinnovations/laya
# auto | cpu | cuda
ROUTER_DEVICE=auto
# Minimum top-probability before the router asks a clarifying question
ROUTER_MIN_CONF=0.55

# --- Refund policy ------------------------------------------------------------
REFUND_WINDOW_DAYS=14
REFUND_AUTO_LIMIT=20

# --- Knowledge base -----------------------------------------------------------
KB_DIR=./data/knowledge_base
KB_TOP_K=4
KB_MIN_SCORE=0.35
HISTORY_MAX_MESSAGES=12

# --- Storage ------------------------------------------------------------------
DB_PATH=./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
# Guards the staff approval endpoints
ADMIN_API_KEY=change-me

# --- Frontend -----------------------------------------------------------------
API_BASE_URL=http://localhost:8000

# --- Optional tracing (own SQLite traces are always on) -----------------------
LANGFUSE_ENABLED=false
